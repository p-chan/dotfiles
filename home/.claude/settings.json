{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/personal-sync-pr-after-push.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/personal-block-env.sh",
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/personal-block-find.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/personal-block-git-add-all.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/personal-block-git-c.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/personal-block-grep.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/personal-block-main-working-tree-branch.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ]
  },
  "model": "opus",
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo *)",
      "Edit(~/.npmrc)",
      "Read(.env)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)"
    ]
  },
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "dark",
  "voiceEnabled": true
}
