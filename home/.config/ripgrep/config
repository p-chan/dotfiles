--hidden
--glob=!.git

# -u、-uu、-uuu を付けた場合も含め、.env*.example 以外の .env* を除外する
# 否定でない glob は許可リストになってしまうので、.env*.example を含め直すことはできない
# 代わりに、.example で終わらない .env* を除外する
# --iglob は、macOS のデフォルトのファイルシステムと同じく大文字と小文字を区別せずにマッチする
--iglob=!.env
--iglob=!.env{e,le,ple,mple,ample,xample,example}
--iglob=!.env*[!e]
--iglob=!.env*[!l]e
--iglob=!.env*[!p]le
--iglob=!.env*[!m]ple
--iglob=!.env*[!a]mple
--iglob=!.env*[!x]ample
--iglob=!.env*[!e]xample
--iglob=!.env*[!.]example
