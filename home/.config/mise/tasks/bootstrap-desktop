#!/bin/bash

#MISE description="Bootstrap the desktop profile"

set -e

DOTFILES_ROOT="$(mise settings get dotfiles.root 2>/dev/null || true)"
DOTFILES_DIR="${DOTFILES_ROOT%/home}"

if [ -z "$DOTFILES_DIR" ] || [ ! -d "$DOTFILES_DIR" ]; then
  echo "dotfiles.root ('$DOTFILES_ROOT') does not point at a dotfiles checkout. Run scripts/install.sh first." >&2
  exit 1
fi

export DOTFILES_DIR

if [ "${CI:-}" != "true" ]; then
  defaults write NSGlobalDomain AppleLanguages -array "en" "ja"
  defaults write com.apple.HIToolbox AppleFnUsageType -int 0
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 60 "<dict><key>enabled</key><false/></dict>"
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 "<dict><key>enabled</key><false/></dict>"

  defaultbrowser browser

  # Dock の再起動は、すべての項目を設定し終えるまで遅らせる
  # 再起動を繰り返すと、後続の dockutil の呼び出しと競合する可能性があるため
  dockutil --remove all --no-restart
  for app in Fantastical Mimestream Arc Slack Figma 1Password Zed Ghostty; do
    [ -d "/Applications/$app.app" ] && dockutil --add "/Applications/$app.app" --no-restart
  done
  killall Dock

  chflags nohidden ~/Library
fi
