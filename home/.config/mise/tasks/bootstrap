#!/bin/bash

#MISE description="Bootstrap this machine"
# zsh ではなく bash を使う
# zsh はスクリプトを含むすべての起動時に ~/.zshenv を読み込む
# このタスクが実行される時点では dotfiles のフェーズで ~/.zshenv がすでにシンボリックリンクされているので、zsh のタスクでは PATH や mise activate の設定を無駄にやり直すことになる
# bash はスクリプトの実行時に rc ファイルを読み込まない

set -e

# 以降の手順は dotfiles のチェックアウトからファイルを読み込む
# その場所は mise の dotfiles.root 設定（scripts/install.sh が <checkout>/home として記録する）にあるので、環境変数を設定しなくても `mise bootstrap` を実行できる
DOTFILES_ROOT="$(mise settings get dotfiles.root 2>/dev/null || true)"
DOTFILES_DIR="${DOTFILES_ROOT%/home}"

if [ -z "$DOTFILES_DIR" ] || [ ! -d "$DOTFILES_DIR" ]; then
  echo "dotfiles.root ('$DOTFILES_ROOT') does not point at a dotfiles checkout. Run scripts/install.sh first." >&2
  exit 1
fi

export DOTFILES_DIR

mdm_enrolled () {
  profiles status -type enrollment 2>/dev/null | grep -q '^MDM enrollment: Yes'
}

if [ "${CI:-}" != "true" ]; then
  if mdm_enrolled; then
    echo "Skipping the machine rename: this Mac is MDM-enrolled and named by its MDM."
  else
    MODEL_NAME=$(system_profiler SPHardwareDataType | awk -F': ' '/Model Name/ {print $2}')
    COMPUTER_NAME="P-Chan's $MODEL_NAME"
    LOCAL_HOST_NAME="p-chan-$(echo "$MODEL_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g')"

    if [ "$(scutil --get ComputerName 2>/dev/null || true)" != "$COMPUTER_NAME" ]; then
      sudo scutil --set ComputerName "$COMPUTER_NAME"
    fi
    if [ "$(scutil --get LocalHostName 2>/dev/null || true)" != "$LOCAL_HOST_NAME" ]; then
      sudo scutil --set LocalHostName "$LOCAL_HOST_NAME"
    fi
  fi
fi

if type ya >/dev/null 2>&1; then
  # `ya pkg add` は登録済みのパッケージに対して 0 以外で終了するので、`ya pkg list` に表示されるものはスキップして、このタスクを冪等に保つ
  registered_packages="$(ya pkg list 2>/dev/null || true)"
  while IFS= read -r package; do
    case "$package" in
      ''|'#'*) continue ;;
    esac
    case "$registered_packages" in
      *"$package"*) continue ;;
    esac
    ya pkg add "$package"
  done < "$DOTFILES_DIR/home/.config/yazi/packages.txt"
fi

if ! type claude >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

if type gh >/dev/null 2>&1; then
  while IFS= read -r extension; do
    case "$extension" in
      ''|'#'*) continue ;;
    esac
    gh extension install "$extension"
  done < "$DOTFILES_DIR/home/.config/gh/extensions"
fi

if type apm >/dev/null 2>&1 && [ -f "$DOTFILES_DIR/home/.apm/apm.yml" ]; then
  apm install -g --target agent-skills
fi

bash "$DOTFILES_DIR/scripts/install-herdr-claude-integration.sh"
