# Homebrew では、公式でない tap を明示的に信頼する必要がある（tap trust）
# tap 全体ではなく、実際に使う cask だけを信頼する
tap "steipete/tap", trusted: { cask: "codexbar" }
cask "1password"
cask "arc"
cask "cleanshot"
cask "codexbar"
cask "cyberduck"
cask "fantastical"
cask "figma"
cask "font-source-han-code-jp"
cask "font-symbols-only-nerd-font"
cask "ghostty"
cask "google-chrome"
cask "google-japanese-ime"
cask "handy"
cask "istat-menus"
cask "karabiner-elements"
cask "logi-options+"
cask "mimestream"
cask "raycast"
cask "slack"
cask "zed"
