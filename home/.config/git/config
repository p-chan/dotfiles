[user]
  name = P-Chan
  email = hello@0x50.io

[core]
  editor = vim
  pager = hunk pager

[color]
  ui = auto

[alias]
  b = branch
  c = commit
  co = checkout
  sw = switch

[init]
  defaultBranch = main

[fetch]
  prune = true

[push]
  default = current
  autoSetupRemote = true

[pull]
  rebase = false

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[filter "jsonsort"]
  # オブジェクトのキーと配列を正規化してから Git に保存する。
  clean = jq -S 'walk(if type == \"array\" then sort else . end)'

[ghq]
  root = ~/src

[wt]
  copyignored = true
  nocopy = node_modules/
  # Not &&: a hook that exits non-zero aborts git wt and blocks its cd.
  hook = "! [ -f package.json ] || ni"

[include]
  path = config.local
