#!/usr/bin/env bash
# starship のプロンプトの [custom.dir] モジュールに表示するディレクトリを出力する
#
# Git リポジトリの中では、リポジトリ名を起点に、リポジトリのルートからの相対パスを表示する（ホームからの祖先のパスは付けない）
# 長いサブパスは中間を "…" に畳み、末尾の 2 つの要素だけを残す
# 深い階層のファイルでも場所を特定でき、プロンプトが際限なく長くならないようにするため
# worktree（git-wt で作成したものなど）は、メインのリポジトリでの論理的な位置に正規化し、物理的な ".wt/branch-name" の構成を隠す
# たとえば "~/dotfiles/.wt/branch-name/home/.config" は "dotfiles/home/.config" と表示する
# ブランチは [custom.git_branch] が表示するので、worktree のルートまで表示すると冗長になるため
#
# Git リポジトリの外では、$HOME からの相対パスを fish shell 風に短縮して表示する
# （祖先のディレクトリは先頭の 1 文字に省略し、最後のディレクトリは省略しない）

pwd_path="$PWD"

if git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ -d "$git_root/.git" ]; then
    main_root=$git_root
  else
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
    case "$common_dir" in
      /*) ;;
      *) common_dir="$pwd_path/$common_dir" ;;
    esac
    main_root=$(cd "${common_dir%/*}" 2>/dev/null && pwd)
    [ -n "$main_root" ] || main_root=$git_root
  fi
  repo_name=${main_root##*/}
  [ -n "$repo_name" ] || repo_name=/
  rel=${pwd_path#"$git_root"}
  rel=${rel#/}

  case "$rel" in
    "") out=$repo_name ;;
    */*/*)
      tail=${rel##*/}
      parent=${rel%/*}
      out="$repo_name/…/${parent##*/}/$tail"
      ;;
    *) out="$repo_name/$rel" ;;
  esac

  printf '%s' "$out"
elif [ "$pwd_path" = "$HOME" ]; then
  printf '~'
else
  tail=${pwd_path##*/}
  [ -n "$tail" ] || tail=/
  prefix=${pwd_path%/*}
  [ -n "$prefix" ] || prefix=/

  case "$prefix" in
    "$HOME") short="~" ;;
    "$HOME"/*) short="~${prefix#"$HOME"}" ;;
    *) short="$prefix" ;;
  esac

  out=""
  case "$short" in
    /*) out="/" ;;
  esac
  IFS='/' read -ra parts <<<"$short"
  for part in "${parts[@]}"; do
    [ -z "$part" ] && continue
    if [ "$part" = "~" ]; then
      out+="$part/"
    elif [[ "$part" == .* ]]; then
      out+="${part:0:2}/"
    else
      out+="${part:0:1}/"
    fi
  done

  printf '%s%s' "$out" "$tail"
fi
