#!/usr/bin/env zsh

set -euo pipefail

dots_up() {
  if [[ -z "${DOTFILES_DIR:-}" ]]; then
    echo "DOTFILES_DIR is not defined"
    return 1
  fi

  echo "Updating Command Line Tools..."
  local clt_label
  clt_label=$(softwareupdate -l 2>&1 | grep "Label: Command Line Tools" | sed 's/.*Label: //' | head -1 || true)
  if [[ -n "${clt_label}" ]]; then
    sudo softwareupdate -i "${clt_label}"
  else
    echo "Command Line Tools is up to date."
  fi

  echo "\nUpdating Homebrew..."
  brew update
  brew upgrade

  echo "\nUpdating mise..."
  mise self-update --yes
  mise up --yes

  echo "\nUpdating system packages for active profiles..."
  mise bootstrap --only packages --update --yes
  mise bootstrap packages upgrade --yes

  echo "\nUpdating gh extensions..."
  gh extension upgrade --all

  echo "\nUpdating Claude Code..."
  claude update

  echo "\nRefreshing the Herdr Claude integration..."
  bash "$DOTFILES_DIR/scripts/install-herdr-claude-integration.sh"

  echo "\nDone!"
}

# ghq で管理しているリポジトリから、削除してよい worktree を「リポジトリ<TAB>worktree<TAB>ブランチ」で出力します
# 未コミットの変更や追跡していないファイルがなく、ブランチの先頭がマージ済みの PR の head と一致するものが対象です
# デフォルトブランチの祖先かどうかでは判定しません。作ったばかりでコミットのない worktree も祖先になり、消えてしまうためです
_merged_worktrees() {
  command -v ghq &>/dev/null && command -v gh &>/dev/null || return 0

  local repo top wt branch out tip
  for repo in ${(f)"$(ghq list -p)"}; do
    top=$(git -C "${repo}" rev-parse --show-toplevel 2>/dev/null) || continue
    git -C "${repo}" worktree list --porcelain 2>/dev/null \
      | awk '/^worktree /{p=substr($0,10)} /^branch /{print p "\t" substr($0,19)}' \
      | while IFS=$'\t' read -r wt branch; do
        [[ "${wt}" != "${top}" ]] || continue
        out=$(git -C "${wt}" status --porcelain 2>/dev/null) || continue
        [[ -z "${out}" ]] || continue
        tip=$(git -C "${repo}" rev-parse "refs/heads/${branch}" 2>/dev/null) || continue
        out=$(cd "${repo}" && gh pr list --head "${branch}" --state merged --json headRefOid -q '.[].headRefOid' </dev/null 2>/dev/null) || continue
        [[ "${out}" == *"${tip}"* ]] || continue
        printf "%s\t%s\t%s\n" "${repo}" "${wt}" "${branch}"
      done
  done
}

dots_cleanup() {
  if [[ "${PWD}" != "${HOME}" ]]; then
    echo "Error: dots cleanup must be run from the home directory"
    exit 1
  fi

  _storage_snapshot() {
    swift -e '
      import Foundation
      let url = URL(fileURLWithPath: "/")
      let keys: Set<URLResourceKey> = [.volumeTotalCapacityKey, .volumeAvailableCapacityForImportantUsageKey]
      let v = try! url.resourceValues(forKeys: keys)
      let total = Int64(v.volumeTotalCapacity!)
      let avail = v.volumeAvailableCapacityForImportantUsage!
      let used = total - avail
      print(String(format: "%.2f %.2f", Double(used)/1e9, Double(avail)/1e9))
    '
  }

  local before
  before=($(_storage_snapshot))

  echo "\nCleaning Homebrew..."
  brew cleanup || true

  echo "\nCleaning mise..."
  mise prune --yes || true

  echo "\nCleaning npm..."
  command -v npm &>/dev/null && npm cache clean --force || true

  echo "\nCleaning yarn..."
  command -v yarn &>/dev/null && yarn cache clean || true

  echo "\nCleaning pnpm..."
  command -v pnpm &>/dev/null && pnpm store prune || true

  echo "\nCleaning Docker..."
  command -v docker &>/dev/null && docker system prune -f || true

  echo "\nCleaning opensrc..."
  command -v opensrc &>/dev/null && opensrc clean || true

  echo "\nCleaning merged worktrees..."
  local repo wt branch
  _merged_worktrees | while IFS=$'\t' read -r repo wt branch; do
    echo "Removing ${wt}"
    git -C "${repo}" wt -D "${branch}" </dev/null || true
  done

  local after
  after=($(_storage_snapshot))
  local freed=$(awk "BEGIN {printf \"%.2f\", ${before[1]} - ${after[1]}}")
  echo "\nCleaned up ${freed} GB (${after[1]} GB used, ${after[2]} GB available)"
}

# dots cleanup で解放できる容量を見積もります
dots_cleanup_dry_run() {
  if [[ "${PWD}" != "${HOME}" ]]; then
    echo "Error: dots cleanup must be run from the home directory"
    exit 1
  fi

  # ディレクトリのサイズをバイト数で出力します。存在しなければ 0 です
  # 権限エラーなどで du が失敗したときは、何も出力せずに失敗します
  _dir_bytes() {
    local total=0 kb
    for dir in "$@"; do
      [[ -e "${dir}" ]] || continue
      kb=$(du -sk "${dir}" 2>/dev/null | awk '{print $1}') || return 1
      total=$((total + ${kb:-0} * 1024))
    done
    echo "${total}"
  }

  # "3GB" や "34.6MB" のような表記をバイト数に変換します
  _parse_size() {
    awk -v s="$1" 'BEGIN {
      if (!match(s, /^[0-9.]+/)) { print 0; exit }
      n = substr(s, 1, RLENGTH); u = toupper(substr(s, RLENGTH + 1))
      m = 1
      if (u ~ /^K/) m = 1e3; else if (u ~ /^M/) m = 1e6
      else if (u ~ /^G/) m = 1e9; else if (u ~ /^T/) m = 1e12
      printf "%.0f", n * m
    }'
  }

  local total=0 upper=0 failed=0

  # 見積もりを 1 行表示して合計に加えます。上限値のときは第 3 引数に upper を渡します
  # バイト数が空のときは、取得に失敗したものとして扱います
  _report() {
    local name="$1" bytes="$2" kind="${3:-}"
    if [[ -z "${bytes}" ]]; then
      printf "  %-10s    %6s\n" "${name}" "failed"
      failed=1
      return
    fi
    local gb=$(awk "BEGIN {printf \"%.2f\", ${bytes} / 1e9}")
    if [[ "${kind}" == "upper" ]]; then
      printf "  %-10s <= %6s GB\n" "${name}" "${gb}"
      upper=$((upper + bytes))
    else
      printf "  %-10s    %6s GB\n" "${name}" "${gb}"
      total=$((total + bytes))
    fi
  }

  local out bytes

  echo "Estimating reclaimable space..."

  if command -v brew &>/dev/null; then
    bytes=""
    if out=$(brew cleanup --dry-run 2>/dev/null); then
      out=$(echo "${out}" | sed -n 's/.*would free approximately \([0-9.]*[A-Za-z]*\).*/\1/p')
      bytes=$(_parse_size "${out:-0}")
    fi
    _report "Homebrew" "${bytes}"
  fi

  if command -v mise &>/dev/null; then
    bytes=""
    if out=$(NO_COLOR=1 mise prune --dry-run 2>&1); then
      local mise_dirs=("${(@f)$(echo "${out}" | sed -n 's/.*\[dryrun\] *remove //p' | tr ',' '\n' | sed "s|^ *~|${HOME}|")}")
      bytes=$(_dir_bytes "${mise_dirs[@]}") || bytes=""
    fi
    _report "mise" "${bytes}"
  fi

  if command -v npm &>/dev/null; then
    bytes=""
    out=$(npm config get cache 2>/dev/null) && bytes=$(_dir_bytes "${out}/_cacache") || bytes=""
    _report "npm" "${bytes}"
  fi

  if command -v yarn &>/dev/null; then
    bytes=""
    out=$(yarn cache dir 2>/dev/null) && bytes=$(_dir_bytes "${out}") || bytes=""
    _report "yarn" "${bytes}"
  fi

  # pnpm store prune には dry-run がないので、ストア全体のサイズを上限とします
  if command -v pnpm &>/dev/null; then
    bytes=""
    out=$(pnpm store path 2>/dev/null) && bytes=$(_dir_bytes "${out}") || bytes=""
    _report "pnpm" "${bytes}" upper
  fi

  # docker system prune は未使用のイメージの一部しか消さないので、上限とします
  # デーモンが止まっているときなど、docker info が失敗したときは見積もれないので、その旨を表示して合計から除きます
  if command -v docker &>/dev/null && ! docker info &>/dev/null; then
    printf "  %-10s    %s\n" "Docker" "skipped (docker unavailable)"
  elif command -v docker &>/dev/null; then
    bytes=""
    if out=$(docker system df --format '{{.Reclaimable}}' 2>/dev/null); then
      bytes=0
      local size
      for size in $(echo "${out}" | awk '{print $1}'); do
        bytes=$((bytes + $(_parse_size "${size}")))
      done
    fi
    _report "Docker" "${bytes}" upper
  fi

  if command -v opensrc &>/dev/null; then
    _report "opensrc" "$(_dir_bytes "${HOME}/.opensrc")"
  fi

  if command -v ghq &>/dev/null && command -v gh &>/dev/null; then
    local wt_dirs=("${(@f)$(_merged_worktrees | cut -f2)}")
    _report "worktrees" "$(_dir_bytes "${wt_dirs[@]}")"
  fi

  local total_gb=$(awk "BEGIN {printf \"%.2f\", ${total} / 1e9}")
  local max_gb=$(awk "BEGIN {printf \"%.2f\", (${total} + ${upper}) / 1e9}")
  echo "\nEstimated: about ${total_gb} GB (up to ${max_gb} GB)"
  if (( failed )); then
    echo "Some estimates failed and are not included in the total"
  fi
}

dots_edit() {
  local repo_dir
  repo_dir="${DOTFILES_DIR:-}"
  if [[ -z "${repo_dir}" ]]; then
    echo "DOTFILES_DIR is not defined"
    return 1
  fi
  "${EDITOR:-vim}" "${repo_dir}"
}

case "${1:-}" in
  up)
    dots_up
    ;;
  cleanup)
    if [[ "${2:-}" == "--dry-run" ]]; then
      dots_cleanup_dry_run
    else
      dots_cleanup
    fi
    ;;
  edit)
    dots_edit
    ;;
  *)
    echo "Usage: dots <command>

Commands:
  up       Update Homebrew and mise
  cleanup  Clean up unused packages and free disk space
  cleanup --dry-run  Estimate reclaimable space without cleaning
  edit     Open dotfiles with the default editor"
    exit 1
    ;;
esac
