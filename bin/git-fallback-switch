#!/usr/bin/env zsh

# main と master を相互にフォールバックする git switch で、余計なエラーを出さない
# 使い方（直接実行）: git-fallback-switch <branch> [git switch に渡す追加の引数...]
# シェルのラッパーから `git switch` として呼ばれることを想定しているが、直接実行しても同じように動作する
# デフォルトは "main" で、存在しない場合はもう一方（"master" または "main"）にフォールバックする

set -euo pipefail

_raw_switch() { exec git -c "alias.switch=" switch "$@"; }

# 最初の引数がオプション（--help、-c など）の場合は、そのまま git に委ねる
if [[ "${1-}" == -* ]]; then
  _raw_switch "$@"
fi

target_branch="${1:-main}"
shift || true

# main と master 以外のブランチは、通常どおり切り替える
if [[ "$target_branch" != "main" && "$target_branch" != "master" ]]; then
  _raw_switch "$target_branch" "$@"
fi

fallback_branch=$([ "$target_branch" = "main" ] && echo master || echo main)

# 指定したブランチが存在すれば、それを優先する
if git rev-parse --verify --quiet "$target_branch" >/dev/null; then
  _raw_switch "$target_branch" "$@"
fi

# もう一方が存在すれば、フォールバックする
if git rev-parse --verify --quiet "$fallback_branch" >/dev/null; then
  _raw_switch "$fallback_branch" "$@"
fi

# どちらも存在しない場合は、git に通常のエラーを表示させる
_raw_switch "$target_branch" "$@"
