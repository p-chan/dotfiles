#!/usr/bin/env zsh

# 現在のブランチで加えた変更を Hunk でレビューする
# レビューのベースとの merge-base から作業ツリーまでの差分を表示するので、
# コミットしていない変更（エージェントがレビューノートに対応した変更など）も含まれる
#
# 使い方: local-review [base] [hunk diff のオプション...]
#
# ベースは以下の順に決める
#   1. 明示した引数
#   2. 現在のブランチで開いている PR のベースブランチ
#   3. デフォルトブランチ（origin/HEAD）
#   4. main または master

set -euo pipefail

fail() {
  echo "local-review: $1" >&2
  exit 1
}

# ローカルのブランチは遅れている可能性があるので、origin/<base> を優先する
# fetch はベースがローカルにない場合だけ行う
# merge-base の算出に必要なのはブランチの分岐元のコミットだけで、古い origin/<base> にもすでに含まれているため
resolve_ref() {
  local name="$1"

  if git rev-parse --verify --quiet "refs/remotes/origin/$name" >/dev/null; then
    echo "origin/$name"
    return
  fi

  if git rev-parse --verify --quiet "$name^{commit}" >/dev/null; then
    echo "$name"
    return
  fi

  if git remote get-url origin >/dev/null 2>&1 &&
    git fetch --quiet origin "refs/heads/${name}:refs/remotes/origin/${name}" 2>/dev/null &&
    git rev-parse --verify --quiet "refs/remotes/origin/$name" >/dev/null; then
    echo "origin/$name"
    return
  fi

  return 1
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "not a git repository"

base=""
# PR のベースの先頭コミット
# ローカルに存在すればそのまま使うので、origin/<base> が古い場合や、PR が別のリモートを対象にしている場合でも正しいベースになる
base_oid=""
if [[ $# -gt 0 && "$1" != -* ]]; then
  base="$1"
  shift
fi

if [[ -z "$base" ]] && command -v gh >/dev/null; then
  pr_base=$(gh pr view --json baseRefName,baseRefOid,state --jq 'select(.state == "OPEN") | "\(.baseRefName) \(.baseRefOid)"' 2>/dev/null || true)
  if [[ -n "$pr_base" ]]; then
    base="${pr_base% *}"
    base_oid="${pr_base#* }"
  fi
fi

if [[ -z "$base" ]]; then
  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  base="${base#origin/}"
fi

if [[ -z "$base" ]]; then
  for candidate in main master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null ||
      git rev-parse --verify --quiet "refs/remotes/origin/$candidate" >/dev/null; then
      base="$candidate"
      break
    fi
  done
fi

[[ -n "$base" ]] || fail "could not determine the base; pass it as an argument"

if [[ -n "$base_oid" ]] && git rev-parse --verify --quiet "$base_oid^{commit}" >/dev/null; then
  ref="$base_oid"
else
  ref=$(resolve_ref "$base") || fail "base not found: $base"
fi
merge_base=$(git merge-base HEAD "$ref") || fail "no merge-base between HEAD and $ref"

exec hunk diff "$merge_base" "$@"
